{
  "version": 2,
  "builds": [
    { "src": "html/*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/html/index.html" },
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "src": "/privacy.html", "dest": "/html/privacy-policy.html" },
    { "src": "/terms.html", "dest": "/html/terms-of-service.html" },
    { "src": "/privacy-policy.html", "dest": "/html/privacy-policy.html" },
    { "src": "/terms-of-service.html", "dest": "/html/terms-of-service.html" }
  ]
}
